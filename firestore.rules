rules_version = '2';

// Security rules for Sky Dodger's leaderboard.
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nicknameOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.nickname;
    }

    // A leaderboard row: only your own, only with your real nickname,
    // a sane score, and a server timestamp.
    function validEntry(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'score', 'updatedAt'])
        && d.score is int
        && d.score > 0
        && d.score <= 1000000
        && d.nickname == nicknameOf(uid)
        && d.updatedAt == request.time;
    }

    // Scores may only go up; a rename may rewrite the row with the same score.
    function improves() {
      return request.resource.data.score > resource.data.score
        || (request.resource.data.score == resource.data.score
            && request.resource.data.nickname != resource.data.nickname);
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'nicknameKey', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-z0-9_]{3,15}$')
        && request.resource.data.nicknameKey == request.resource.data.nickname.lower()
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nicknameKey)).data.uid == uid;
      allow delete: if false;
    }

    match /nicknames/{key} {
      allow read: if true;
      allow create: if signedIn()
        && key.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /leaderboard_alltime/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validEntry(uid);
      allow update: if isOwner(uid) && validEntry(uid) && improves();
      allow delete: if false;
    }

    match /leaderboard_weekly/{week}/entries/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validEntry(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$');
      allow update: if isOwner(uid) && validEntry(uid) && improves();
      allow delete: if false;
    }
  }
}
